---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { photos, salon, widthsFor } from "../data/salon";
const p = photos.chignon;
const a = salon.address.value;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap grid hero-grid">
    <div class="copy">
      <h1 id="hero-title" class="title" data-reveal="lines" data-hero data-delay="150">
        <span class="line"><span>Your hair,</span></span>
        <span class="line"><span>beautifully</span></span>
        <span class="line"><span><em>considered.</em></span></span>
      </h1>
      <div class="support" data-reveal="fade" data-hero data-delay="650">
        <p class="lede">A colour-led salon on Newgate Street in Morpeth, where every appointment starts with a conversation about you.</p>
        <div class="actions">
          <a class="btn" href="#book">Book an appointment <Icon name="arrow" /></a>
          <a class="link" href="#salon">Explore the salon</a>
        </div>
      </div>
    </div>

    <figure class="visual frame" data-reveal="clip" data-hero data-delay="250">
      <div class="drift" data-parallax="0.05">
        <Picture src={p.src} alt={p.alt} formats={["avif", "webp"]} widths={widthsFor(p.src)} sizes="(max-width: 48rem) 100vw, 42vw" loading="eager" fetchpriority="high" style={`object-position:${p.focus}`} />
      </div>
    </figure>

    <p class="meta" data-reveal="fade" data-hero data-delay="900">
      <span>{a.street}, {a.town}</span>
      <a class="cue" href="#salon"><span>Scroll</span><i aria-hidden="true"></i></a>
    </p>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px)); min-height: min(100svh, 62rem); display: grid; }
  .hero-grid { grid-template-rows: 1fr auto; row-gap: 2rem; align-items: center; padding-block: clamp(1.5rem, 4vh, 3.5rem) clamp(1.25rem, 3vh, 2.5rem); }
  .copy { grid-column: 1 / span 7; grid-row: 1; display: grid; gap: clamp(2rem, 4vh, 3.25rem); position: relative; z-index: 1; }
  .title { font-size: var(--fs-hero); line-height: 0.9; letter-spacing: -0.02em; font-weight: 350; }
  .title em { color: var(--champagne-ink); }
  .support { display: grid; gap: 1.75rem; max-width: 27rem; margin-left: clamp(0rem, 8vw, 8.5rem); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }

  .visual {
    grid-column: 8 / span 5; grid-row: 1 / span 2; margin: 0;
    /* runs off the right edge of the page: the photograph is cropped by the screen, not by a box */
    margin-right: calc(-1 * max(var(--margin), (100vw - var(--max)) / 2 + var(--margin)));
    align-self: stretch; min-height: 34rem; max-height: 52rem;
  }
  .drift { position: absolute; inset: -4% 0; }
  .visual :global(picture), .visual :global(img) { width: 100%; height: 100%; }
  .visual :global(img) { object-fit: cover; }

  .meta { grid-column: 1 / span 7; grid-row: 2; display: flex; justify-content: space-between; align-items: center; gap: 1rem; font: 500 var(--fs-label)/1.2 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; color: var(--stone); padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .cue { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; color: inherit; min-height: 2.75rem; }
  .cue i { width: 3rem; height: 1px; background: currentColor; transform-origin: left; animation: cue 2.8s var(--ease-in-out) infinite; }
  @keyframes cue { 0% { transform: scaleX(0); transform-origin: left; } 45% { transform: scaleX(1); transform-origin: left; } 55% { transform: scaleX(1); transform-origin: right; } 100% { transform: scaleX(0); transform-origin: right; } }

  @media (max-width: 64rem) {
    .copy { grid-column: 1 / span 8; }
    .visual { grid-column: 8 / span 5; }
    .support { margin-left: 0; }
  }
  @media (max-width: 48rem) {
    .hero { min-height: auto; }
    .hero-grid { grid-template-rows: auto; row-gap: 2rem; padding-top: 1.5rem; }
    .copy { display: contents; }
    .title { grid-column: 1 / -1; grid-row: 1; }
    .visual { grid-column: 1 / -1; grid-row: 2; margin-inline: calc(-1 * var(--margin)); min-height: 0; max-height: none; aspect-ratio: 4 / 5; }
    .support { grid-column: 1 / -1; grid-row: 3; }
    .meta { grid-column: 1 / -1; grid-row: 4; }
    .actions .btn { flex: 1 1 100%; }
  }
  @media (min-width: 30rem) and (max-width: 48rem) { .visual { aspect-ratio: 1; } }
  @media (prefers-reduced-motion: reduce) { .cue i { animation: none; transform: none; } }
</style>
