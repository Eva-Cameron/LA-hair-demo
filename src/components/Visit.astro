---
import Icon from "./Icon.astro";
import { salon } from "../data/salon";
const a = salon.address.value;
const phone = salon.phone.value;
const hours = salon.openingHours;
---
<section class="section visit" id="visit" aria-labelledby="visit-title">
  <div class="wrap grid">
    <h2 id="visit-title" class="display title" data-reveal="lines">
      <span class="line"><span>Find us on</span></span>
      <span class="line"><span>Newgate Street</span></span>
    </h2>
    <div class="cols">
      <div class="col" data-reveal="fade">
        <p class="label">Address</p>
        <address>{salon.name}<br />{a.street}<br />{a.town}, {a.county}<br />{a.postcode}</address>
        <a class="link" href={salon.directionsUrl} target="_blank" rel="noopener">Get directions <Icon name="arrow-out" /><span class="visually-hidden">(opens Google Maps in a new tab)</span></a>
      </div>
      <div class="col" data-reveal="fade" data-delay="100">
        <p class="label">Telephone</p>
        <a class="big" href={phone.href}>{phone.display}</a>
        <p class="muted">The quickest way to book, change an appointment or ask a question.</p>
      </div>
      <div class="col" data-reveal="fade" data-delay="200">
        <p class="label">Opening times</p>
        {hours ? (
          <dl class="hours">{hours.map((h) => <div><dt>{h.day}</dt><dd>{h.opens}–{h.closes}</dd></div>)}</dl>
        ) : (
          <p class="big-text">Please call for current opening times and availability.</p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .visit .grid { row-gap: clamp(3rem, 6vw, 5rem); }
  .title { grid-column: 1 / span 9; }
  .cols { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .col { display: grid; align-content: start; gap: 1rem; padding: 1.75rem 2rem 0 0; }
  .col + .col { padding-left: 2rem; border-left: 1px solid var(--rule); }
  address { font: normal 400 1.6rem/1.3 var(--serif); }
  .big { font: 400 2rem/1.1 var(--serif); text-decoration: none; justify-self: start; background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat; padding-bottom: 0.2rem; }
  .big-text { font: 400 1.6rem/1.3 var(--serif); }
  .col .muted { font-size: var(--fs-small); max-width: 22rem; }
  .link { justify-self: start; }
  .hours div { display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid var(--rule); font-variant-numeric: tabular-nums; }
  .hours dd { margin: 0; }
  @media (max-width: 64rem) {
    .title { grid-column: 1 / -1; }
    .cols { grid-template-columns: 1fr; }
    .col, .col + .col { padding: 1.75rem 0; border-left: 0; border-bottom: 1px solid var(--rule); }
  }
</style>
