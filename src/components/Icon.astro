---
/** The few icons the site needs, drawn on a 24 grid with one hairline stroke. */
interface Props { name: "arrow" | "arrow-out" | "menu" | "close" | "phone" | "pin"; class?: string }
const { name, class: cls = "" } = Astro.props;
const paths: Record<Props["name"], string> = {
  arrow: '<path d="M4 12h15"/><path d="m14 7 5 5-5 5"/>',
  "arrow-out": '<path d="M7 17 17 7"/><path d="M9 7h8v8"/>',
  menu: '<path d="M3.5 9h17"/><path d="M3.5 15h17"/>',
  close: '<path d="m6 6 12 12"/><path d="M18 6 6 18"/>',
  phone: '<path d="M8.6 3.5H6.2A1.7 1.7 0 0 0 4.5 5.4C5 13.6 10.4 19 18.6 19.5a1.7 1.7 0 0 0 1.9-1.7v-2.4a1 1 0 0 0-.8-1l-3.1-.7a1 1 0 0 0-1 .3l-1.4 1.6a12.4 12.4 0 0 1-5.3-5.3l1.6-1.4a1 1 0 0 0 .3-1l-.7-3.1a1 1 0 0 0-1-.8Z"/>',
  pin: '<path d="M18.5 10c0 4.75-6.5 11-6.5 11S5.5 14.75 5.5 10a6.5 6.5 0 0 1 13 0Z"/><circle cx="12" cy="10" r="2.25"/>',
};
---
<svg class={`icon ${name === "arrow" || name === "arrow-out" ? "arrow" : ""} ${cls}`} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" set:html={paths[name]} />
