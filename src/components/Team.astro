---
import { Picture } from "astro:assets";
import { team, widthsFor } from "../data/salon";
---
<section class="section surface-ivory team" id="team" aria-labelledby="team-title">
  <div class="wrap grid">
    <div class="intro">
      <p class="label" data-reveal="fade">Meet the team</p>
      <h2 id="team-title" class="h2" data-reveal="lines">
        <span class="line"><span>Laura &amp;</span></span>
        <span class="line"><span>the team</span></span>
      </h2>
      <p class="muted" data-reveal="fade" data-delay="120">Laura leads a small team of stylists and colourists at the salon on Newgate Street.</p>
    </div>
    <ul class="people">
      {team.map((m, i) => (
        <li class="person" data-reveal="fade" data-delay={String(i * 100)}>
          <div class="portrait frame">
            {m.portrait ? (
              <Picture src={m.portrait.src} alt={m.portrait.alt} formats={["avif", "webp"]} widths={widthsFor(m.portrait.src, [320, 480, 640])} sizes="(max-width: 48rem) 80vw, 24rem" loading="lazy" />
            ) : (
              <span class="initials" aria-hidden="true">{m.name.split(" ").map((w) => w[0]).join("")}</span>
            )}
          </div>
          <h3 class="name">{m.name}</h3>
          <p class="label role">{m.role}</p>
          {m.bio && <p class="muted bio">{m.bio}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team .grid { row-gap: 3rem; align-items: start; }
  .intro { grid-column: 1 / span 5; display: grid; gap: 1.5rem; position: sticky; top: calc(var(--header-h) + 2rem); }
  .intro .muted { max-width: 26rem; }
  .people { grid-column: 7 / span 4; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 3rem var(--gutter); }
  .person { display: grid; gap: 0.6rem; }
  .portrait { aspect-ratio: 3 / 4; display: grid; place-items: center; background: var(--chalk); border: 1px solid var(--rule); margin-bottom: 0.6rem; }
  .portrait :global(picture), .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .initials { font: italic 400 clamp(5rem, 3rem + 6vw, 8rem)/1 var(--serif); color: var(--champagne-ink); }
  .name { font-size: 1.75rem; }
  @media (max-width: 64rem) { .intro { grid-column: 1 / -1; position: static; } .people { grid-column: 1 / -1; } }
</style>
