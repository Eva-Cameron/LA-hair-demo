# Canonical domain. Enables canonical URLs and sitemap.xml.
SITE_URL=

# Form endpoint that accepts a JSON POST and emails the salon (e.g. a Formspree form URL
# or a Cloudflare Pages Function). Leave empty and the enquiry form is not shown; the
# booking section then offers the telephone route only. The form never shows success
# unless this endpoint answers with a 2xx.
PUBLIC_ENQUIRY_ENDPOINT=
